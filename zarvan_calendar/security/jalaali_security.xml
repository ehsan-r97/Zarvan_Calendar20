<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_jalaali" model="ir.module.category">
            <field name="name">Persian Calendar</field>
            <field name="description">Manage Jalali holidays and calendar settings</field>
            <field name="sequence">50</field>
        </record>

        <!-- Odoo 19/20 Three-Tier Security Architecture: Category -> Privilege -> Group -> User -->
        <record id="privilege_jalaali_access" model="res.groups.privilege">
            <field name="name">Persian Calendar Access</field>
            <field name="category_id" ref="module_category_jalaali"/>
        </record>

        <record id="group_jalaali_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_jalaali_access"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_jalaali_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_jalaali_access"/>
            <field name="implied_ids" eval="[(4, ref('group_jalaali_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
